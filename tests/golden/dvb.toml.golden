## dvb reference configuration
##
## Convention:
## - Uncommented lines are required options forming a minimal valid config.
## - Optional settings are commented out with `# `, preceded by `## optional: <description>`.
## - Alternative storage backends are commented out under `## alternative storage: <type>`.
## - Never store secrets inline in production. Use file mounts (e.g. /run/secrets/...)
##   or environment variable overrides (e.g. DVB__JOB__BACKUP__STORAGE__SECRET_ACCESS_KEY).

## optional: Seconds to wait for running jobs to finish when shutting down before cancelling them.
# shutdown_grace_secs = 60

## optional: Docker daemon settings for the container hooks that run via `docker exec`.
# [docker]
## optional: Path to the Docker unix socket.
# socket = "/var/run/docker.sock"

[job.backup]
## optional: 5-field cron schedule.
cron = "0 3 * * *"
## optional: natural-language schedule (use either cron or crontext, not both).
# crontext = "every day at 03:00"
source = ["/backup/data"]
filename = "backup-%Y%m%dT%H%M%SZ.tar.zst"
compression = "zstd"
retention_days = 14
min_keep = 3

## optional: Timezone for schedule evaluation (e.g. "Europe/Berlin", "UTC"). Defaults to system TZ or UTC.
# timezone = "Europe/Berlin"

## optional: Run this job immediately on daemon startup before its first scheduled run.
# run_on_start = true

## optional: Store symlink target contents instead of archiving symlinks as symlinks.
# follow_symlinks = false

## optional: Containers to stop during backup for consistency, then restart.
# stop_containers = ["postgres"]

## optional: Label selector (key=value) matching containers to stop during backup.
# stop_label = "dvb.backup=true"

## optional: Seconds to wait for containers to stop cleanly before killing.
# stop_timeout_secs = 30

[job.backup.storage]
type = "s3"
bucket = "my-backup-bucket"
region = "us-east-1"
prefix = "backups"
## optional: Custom endpoint URL for MinIO, Cloudflare R2, Wasabi, SeaweedFS, etc.
# endpoint = "http://minio:9000"
## optional: S3 access key ID (or set via DVB__JOB__BACKUP__STORAGE__ACCESS_KEY_ID or /run/secrets).
# access_key_id = "minioadmin"
## optional: S3 secret access key (or set via DVB__JOB__BACKUP__STORAGE__SECRET_ACCESS_KEY or /run/secrets).
# secret_access_key = "minioadmin"
## optional: Address bucket as path (endpoint/bucket) rather than virtual host (bucket.endpoint).
# force_path_style = true

## optional: Pre-backup hook executed before archiving, in the container or locally.
# [job.backup.pre_backup]
## optional: Executable and arguments run without a shell.
# cmd = ["pg_dump", "-U", "postgres", "-d", "mydb"]
## optional: Path to an executable file instead of `cmd` (run directly, without a shell).
# script = "/scripts/backup.sh"
## optional: Container to run the hook in via `docker exec`. Omit to run locally.
# container = "postgres"
## optional: Hook timeout in seconds.
# timeout_secs = 300

## optional: Post-backup hook executed after archiving.
# [job.backup.post_backup]
## optional: Executable and arguments run without a shell.
# cmd = ["/bin/notify.sh", "Backup completed"]
## optional: Path to an executable file instead of `cmd`.
# script = "/scripts/notify.sh"
## optional: When to run the hook: "success" (default), "failure", or "always".
# run_on = "always"
## optional: Hook timeout in seconds.
# timeout_secs = 60

## optional: Pre-restore hook run before the archive is unpacked.
# [job.backup.pre_restore]
# cmd = ["/bin/check-free-space.sh"]
# container = "postgres"
# timeout_secs = 120

## optional: Post-restore hook executed after extraction.
# [job.backup.post_restore]
## optional: Default directory for backup extraction.
# dir = "/restore"
## optional: Executable and arguments run without a shell.
# cmd = ["pg_restore", "-U", "postgres", "-d", "mydb"]
## optional: Path to an executable script instead of `cmd`.
# script = "/scripts/pg_restore.sh"
## optional: Container to run the hook in via `docker exec`. Omit to run locally.
# container = "postgres"
## optional: Timeout in seconds for the restore hook.
# timeout_secs = 3600

## alternative storage: fs
# [job.backup.storage]
# type = "fs"
# root = "/backup/storage"
# prefix = "backups"

## alternative storage: sftp
# [job.backup.storage]
# type = "sftp"
# endpoint = "sftp.example.com:22"
# user = "backupuser"
# root = "/remote/backups"
# key_path = "/run/secrets/id_ed25519"
# known_hosts_strategy = "strict"

## alternative storage: dropbox
# [job.backup.storage]
# type = "dropbox"
# root = "/backups"
# client_id = "/run/secrets/dropbox_client_id"
# client_secret = "/run/secrets/dropbox_client_secret"
# refresh_token = "/run/secrets/dropbox_refresh_token"